rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 運用者(しおん)1人だけが読み書きできる。UID は Firebase Authentication → Users のもの。
    // webhook(Instagram)・共有ボタン(/api/ideas)・写真から提案(/api/sns/suggest)などのサーバー側は
    // Admin SDK(サービスアカウント)で書くため、このルールをバイパスして動く。
    // このルールは「ブラウザからの直接アクセス」だけを縛る。
    // 運用者を増やすときは、その人の UID を || で足す。
    match /{document=**} {
      allow read, write: if request.auth != null
        && request.auth.uid == "nEbNzVVqayaNlWy4vNsbaNeO5gL2";
    }
  }
}
