rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 認証済みユーザー（＝運用者）のみ読み書きを許可する。
    // webhook / 送信 API などサーバー側は Admin SDK を使うため、このルールを
    // バイパスして書き込める（ルールは「ブラウザからの直接アクセス」だけを縛る）。
    //
    // さらに運用者1人だけに絞るなら、下を次のように UID 固定にする:
    //   allow read, write: if request.auth != null
    //     && request.auth.uid == 'ここに運用者のUID';
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
