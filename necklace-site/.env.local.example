# Stripe — get from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# Used to build absolute URLs in Stripe Checkout images / redirects.
# In dev this is auto-detected from the request origin and can be omitted.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Upstash Redis (analytics + sold-out flags)
# Vercel Marketplace > Upstash で接続すれば KV_REST_API_URL/TOKEN として自動注入される
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# /admin Google OAuth
# 1. https://console.cloud.google.com/apis/credentials で OAuth 2.0 クライアントを作成
# 2. Authorized redirect URI に  https://YOUR_DOMAIN/api/admin/auth/callback を追加
#    （ローカルは http://localhost:3000/api/admin/auth/callback も追加）
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 許可する管理者メール（このメール以外はログインできません）
ADMIN_EMAIL=toraokawazoe@gmail.com

# セッション署名用のランダム文字列（>=32 文字推奨）
# 例: openssl rand -hex 32
ADMIN_SESSION_SECRET=
