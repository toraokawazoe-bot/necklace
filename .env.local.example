NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# --- Instagram DM 連携（後から設定可。未設定でもアプリは通常どおり動作）---
# Webhook の合言葉。自分で決めた任意の文字列を入れ、Meta の Webhook 設定にも同じ値を入力する
INSTAGRAM_VERIFY_TOKEN=
# Meta アプリの App Secret。Webhook 署名の検証に使う（未設定だと検証をスキップ＝開発用のみ）
INSTAGRAM_APP_SECRET=
# 長期アクセストークン。用途は2つ:
#  (1) DM 送信者のユーザー名を自動取得してカードに表示（任意）
#  (2) 管理画面からの DM 返信送信（返信機能を使うなら必須）
# 返信送信には instagram_business_manage_messages 権限と、長期（60日）Instagram User トークンが必要。
# 権限が無い／期限切れの場合、返信は権限エラーや190エラーで失敗する。
INSTAGRAM_ACCESS_TOKEN=
